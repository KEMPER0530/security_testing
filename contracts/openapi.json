              }
            ],
            "title": "Cvss"
          },
          "cvss_reason": {
            "type": "string",
            "title": "Cvss Reason"
          },
          "priority": {
            "type": "string",
            "title": "Priority"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "default": "未評価"
          },
          "severity_basis": {
            "type": "string",
            "title": "Severity Basis",
            "default": "旧レポートのため未評価"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "rule_id",
          "rule_version",
          "title",
          "status",
          "evidence",
          "kind",
          "cvss",
          "cvss_reason",
          "priority"
